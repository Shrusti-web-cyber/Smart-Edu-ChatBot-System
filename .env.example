# SmartEdu email OTP (SMTP)
SMARTEDU_SMTP_HOST=smtp.gmail.com
SMARTEDU_SMTP_PORT=587
SMARTEDU_SMTP_USER=your-email@gmail.com
SMARTEDU_SMTP_PASSWORD=your-16-character-app-password
SMARTEDU_SMTP_FROM=your-email@gmail.com

# SmartEdu AI
OPENAI_API_KEY=your-api-key
SMARTEDU_AI_MODEL=gpt-4.1-mini

# Flask
SMARTEDU_SECRET=replace-with-a-long-random-secret
PORT=5000
